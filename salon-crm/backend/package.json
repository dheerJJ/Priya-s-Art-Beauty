{
  "name": "salon-crm-backend",
  "version": "1.0.0",
  "description": "Salon CRM & WhatsApp Billing Automation Backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "lint": "eslint src --ext .js",
    "test": "jest --runInBand --forceExit",
    "security": "jest tests/security.test.js --runInBand --forceExit",
    "db:security": "jest tests/db-security.test.js --runInBand --forceExit",
    "db:clear": "node scripts/reset_db.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^2.7.0",
    "pdfkit": "^0.15.0",
    "pg": "^8.12.0",
    "uuid": "^14.0.2",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  }
}

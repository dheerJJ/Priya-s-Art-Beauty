NODE_ENV=development
PORT=5000

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/salon_crm

# JWT
JWT_SECRET=change-this-to-a-secure-random-secret-in-production
JWT_EXPIRES_IN=7d

# WhatsApp / Meta
META_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
META_APP_ID=
META_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token

# Public URL (needed for webhook configuration)
PUBLIC_API_URL=http://localhost:5000

# PDF / Invoice Storage (local path for dev)
INVOICE_STORAGE_PATH=./storage/invoices

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
